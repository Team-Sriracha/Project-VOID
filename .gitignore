# Unity 자동 생성 폴더
Library/
Temp/
Obj/
Build/
Builds/
Logs/
UserSettings/
MemoryCaptures/

# Packages 및 ProjectSettings 전체 제외
Packages/
ProjectSettings/

# IDE 설정
.vs/
.vscode/
.idea/

# OS 파일
.DS_Store
Thumbs.db

